  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/">
    <dc:identifier id="book-id">urn:uuid:51deb2d7-5b5e-4fe5-a92f-e38135848029</dc:identifier>
    <dc:title id="title">Revenge of the Iron-Blooded Sword Hound</dc:title>
    <meta refines="#title" property="title-type">main</meta>
    <dc:language>en</dc:language>
    <dc:creator id="creator">Regobal Basso</dc:creator>
    <meta refines="#creator" property="role" scheme="marc:relators">aut</meta>
    <meta refines="#creator" property="file-as">Basso, Regobal</meta>
    <meta refines="#creator" property="alternate-script" xml:lang="ko">레고밟았어</meta>
    <dc:publisher id="publisher">Globurn</dc:publisher>
    <meta refines="#publisher" property="alternate-script" xml:lang="ko">글로번</meta>
    <dc:description>Vikir was the hunting hound of the Baskerville family. After decades of loyal service, he was branded a traitor and executed. Returned forty years into the past, he resolves to live on his own terms—and to turn his former masters into his prey.</dc:description>
    <dc:source id="source-title">철혈검가 사냥개의 회귀</dc:source>
    <dc:relation>The Return of the Iron-Blood Sword Hound</dc:relation>
    <dc:type>Text</dc:type>
    <dc:subject>Action</dc:subject>
    <dc:subject>Adventure</dc:subject>
    <dc:subject>Dark Fantasy</dc:subject>
    <dc:subject>Regression</dc:subject>
    <dc:subject>Swordsmanship</dc:subject>
    <dc:subject>Korean Web Novel</dc:subject>
    <dc:rights>Original work © 레고밟았어 and Globurn. English text and cover artwork were supplied by the user for personal EPUB preparation. This edition does not assert ownership of the underlying novel, translation, or artwork.</dc:rights>
